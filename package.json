{
  "name": "secureops-guardian",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -b",
    "bundle:verifier": "esbuild packages/policy-verifier/src/cli.ts --bundle --platform=node --format=cjs --outfile=packages/policy-verifier/dist/cli.bundle.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "phase5:matrix": "tsx packages/reliability/src/cli.ts",
    "phase6:matrix": "tsx packages/presentation/src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify:policy": "tsx packages/policy-verifier/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.0.1",
    "prettier": "3.9.0",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.0"
  }
}
